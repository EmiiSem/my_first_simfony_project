{% extends 'layout.html.twig' %}

{% block title %}Blog{% endblock %}

{% block body %}
    <h1>Blog</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ blog.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ blog.title }}</td>
            </tr>
            {% if blog.category %}
                <tr>
                    <th>Category</th>
                    <td>{{ blog.category.fullName | raw }}</td>
                </tr>
            {% endif %}
            <tr>
                <th>Description</th>
                <td>{{ blog.description }}</td>
            </tr>
            <tr>
                <th>Text</th>
                <td>{{ blog.text }}</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex gap-5 mb-3">
        <a href="{{ path('app_blog_index') }}" class="btn btn-info">back to list</a>

        <a href="{{ path('app_blog_edit', {'id': blog.id}) }}" class="btn btn-primary">edit</a>
    </div>

    <form method="post" action="{{ path('app_blog_delete', {'id': blog.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ blog.id) }}">
        <button class="btn btn-danger">Delete</button>
    </form>

{% endblock %}
