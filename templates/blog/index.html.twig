{% extends 'layout.html.twig' %}

{% block title %}Blog index{% endblock %}

{% block body %}
    <h1>Blog index</h1>

    {{ form_start(searchForm) }}
    {{ form_widget(searchForm) }}
    <button class="btn btn-primary">Find</button>
    {{ form_end(searchForm) }}

    <br />

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>Text</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for blog in blogs %}
            <tr>
                <td>{{ blog.id }}</td>
                <td>{{ blog.title }}</td>
                <td>{{ blog.description | length > 50 ? blog.description | slice(0, 50) ~ '...' : blog.description }}</td>
                <td>{{ blog.text | length > 50 ? blog.text | slice(0, 50) ~ '...' : blog.text }}</td>
                <td>
                    {% if is_granted('edit', blog) %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_blog_show', {'id': blog.id}) }}">show</a>
                            <a href="{{ path('app_blog_edit', {'id': blog.id}) }}">edit</a>
                        {% else %}
                            <a href="{{ path('app_user_blog_edit', {'id': blog.id}) }}">edit</a>
                        {% endif %}
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_blog_new') }}" class="btn btn-success">Create new</a>
    {% else %}
        <a href="{{ path('app_user_blog_new') }}" class="btn btn-success">Create new</a>
    {% endif %}

{% endblock %}
