{% extends 'layout.html.twig' %}

{% block title %}Edit Blog{% endblock %}

{% block body %}
    <h1>Edit Blog</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button class="btn btn-primary">Update</button>
    {{ form_end(form) }}

    <div class="d-flex align-items-center gap-3">

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_blog_index') }}" class="btn btn-info mt-3 mb-3">back to list</a>

            <form method="post" action="{{ path('app_blog_delete', {'id': blog.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ blog.id) }}">
                <button class="btn btn-danger">Delete</button>
            </form>
        {% else %}
            <a href="{{ path('app_user_blog_index') }}" class="btn btn-info mt-3 mb-3">back to list</a>

            <form method="post" action="{{ path('app_blog_user_delete', {'id': blog.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ blog.id) }}">
                <button class="btn btn-danger">Delete</button>
            </form>
        {% endif %}

    </div>
{% endblock %}
